#!/usr/bin/env bash
# Git hook: after `git pull` / merge on the server, restart PM2.
# Install once on the server:
#   bash scripts/install-git-hooks.sh

set -euo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "${ROOT}" ]; then
  ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
fi

# Only auto-restart on the deployment machine (optional).
# Uncomment and set your server hostname if you want to skip local machines:
# if [ "$(hostname)" != "your-server-hostname" ]; then exit 0; fi

if [ -x "$ROOT/deploy.sh" ]; then
  # Skip nested git pull — code is already updated by the merge.
  cd "$ROOT"
  mkdir -p logs
  if command -v pm2 >/dev/null 2>&1; then
    if pm2 describe geomaps >/dev/null 2>&1; then
      echo "[post-merge] pm2 restart geomaps"
      pm2 restart ecosystem.config.cjs --update-env
      pm2 save
    else
      echo "[post-merge] pm2 start ecosystem.config.cjs"
      pm2 start ecosystem.config.cjs
      pm2 save
    fi
  else
    echo "[post-merge] pm2 not found — skip restart" >&2
  fi
fi
