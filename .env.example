GOOGLE_MAPS_API_KEY=your_api_key_here

# Shared key to access the Route Companion app / API (send as X-App-Key).
# Set the same value on phones when opening the PWA settings.
APP_ACCESS_KEY=change_me_to_a_secret

# Enable in Google Cloud for this project:
# - Routes API (motorbike/car routing)
# - Street View Static API (frames) — record_streetview.py only
# - Places API (New) — Route Companion PWA nearby places + find_spbu --source google
